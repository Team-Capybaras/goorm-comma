// Alloy 설정 파일 - Backend 로그 수집 및 Loki 전송
// Production 환경 호환: 공유 볼륨 방식 사용
// 컨테이너 ID 변경에 영향받지 않음
//
// 작동 방식:
// 1. Spring Boot 애플리케이션이 /app/logs/application.log에 로그를 기록
// 2. docker-compose에서 app_logs 볼륨을 Backend와 Alloy 컨테이너에 마운트
// 3. Alloy가 공유 볼륨의 로그 파일을 tail하여 실시간으로 수집
// 4. 수집된 로그를 Loki로 전송
//
// 이 방식은 개발/로컬/프로덕션 모든 환경에서 동일하게 작동합니다.

// Spring Boot 애플리케이션 로그 파일 수집
// 로그는 /app/logs 디렉토리에 저장되며, docker-compose를 통해 Alloy와 공유됨
// docker-compose에서 app_logs 볼륨을 Backend와 Alloy에 마운트해야 함
loki.source.file "backend_logs" {
  targets = [
    {
      __path__ = "/app/logs/application.log",
      job      = "backend",
    },
  ]
  forward_to = [loki.relabel.backend_logs.receiver]
}

// 로그 레이블 변환
loki.relabel "backend_logs" {
  forward_to = [loki.write.loki.receiver]
  
  // 로그 레벨 추출 (선택사항)
  rule {
    source_labels = ["__line__"]
    target_label  = "level"
    regex         = ".*\\[(INFO|DEBUG|WARN|ERROR|TRACE)\\].*"
    replacement   = "$$1"
  }
  
  // 애플리케이션 이름 레이블
  rule {
    source_labels = []
    target_label  = "application"
    replacement   = "goorm-comma-backend"
  }
}

// Loki 전송 설정
loki.write "loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
  external_labels = {
    environment = "development",
    cluster     = "goorm-comma",
  }
}
