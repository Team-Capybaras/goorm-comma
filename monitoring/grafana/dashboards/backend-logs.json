{
  "dashboard": {
    "title": "Backend Logs Dashboard",
    "tags": ["logs", "backend"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "title": "Log Volume Over Time",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "sum(count_over_time({job=\"backend\"}[1m]))",
            "refId": "A",
            "legendFormat": "Log Lines"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Logs/sec"},
          {"format": "short"}
        ]
      },
      {
        "id": 2,
        "title": "Error Log Volume",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "sum(count_over_time({job=\"backend\"} |= \"ERROR\" [1m]))",
            "refId": "A",
            "legendFormat": "Errors"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Errors/sec"},
          {"format": "short"}
        ]
      },
      {
        "id": 3,
        "title": "Recent Logs",
        "type": "logs",
        "gridPos": {"h": 12, "w": 24, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "{job=\"backend\"}",
            "refId": "A"
          }
        ],
        "options": {
          "showTime": true,
          "showLabels": true,
          "sortOrder": "Descending",
          "wrapLogMessage": false,
          "dedupStrategy": "none"
        }
      }
    ],
    "time": {
      "from": "now-15m",
      "to": "now"
    }
  }
}
