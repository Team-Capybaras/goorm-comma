{
  "dashboard": {
    "title": "Spring Boot Application Logs",
    "tags": ["spring-boot", "logs", "backend"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "title": "Log Volume Over Time",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "sum(count_over_time({job=\"backend\"}[1m]))",
            "refId": "A",
            "legendFormat": "Total Logs"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth"
            }
          }
        }
      },
      {
        "id": 2,
        "title": "Log Level Distribution",
        "type": "piechart",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "sum(count_over_time({job=\"backend\"} |= \"INFO\" [1m]))",
            "refId": "A",
            "legendFormat": "INFO"
          },
          {
            "expr": "sum(count_over_time({job=\"backend\"} |= \"ERROR\" [1m]))",
            "refId": "B",
            "legendFormat": "ERROR"
          },
          {
            "expr": "sum(count_over_time({job=\"backend\"} |= \"WARN\" [1m]))",
            "refId": "C",
            "legendFormat": "WARN"
          },
          {
            "expr": "sum(count_over_time({job=\"backend\"} |= \"DEBUG\" [1m]))",
            "refId": "D",
            "legendFormat": "DEBUG"
          }
        ]
      },
      {
        "id": 3,
        "title": "Recent Logs",
        "type": "logs",
        "gridPos": {"h": 12, "w": 24, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "{job=\"backend\"}",
            "refId": "A"
          }
        ],
        "options": {
          "showTime": true,
          "showLabels": true,
          "sortOrder": "Descending",
          "wrapLogMessage": true,
          "dedupStrategy": "none",
          "enableLogDetails": true
        }
      },
      {
        "id": 4,
        "title": "API Request Logs (ParkServiceImpl)",
        "type": "logs",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
        "targets": [
          {
            "expr": "{job=\"backend\"} |= \"ParkServiceImpl\"",
            "refId": "A"
          }
        ],
        "options": {
          "showTime": true,
          "showLabels": true,
          "sortOrder": "Descending",
          "wrapLogMessage": true,
          "dedupStrategy": "none"
        }
      },
      {
        "id": 5,
        "title": "Error Logs",
        "type": "logs",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
        "targets": [
          {
            "expr": "{job=\"backend\"} |= \"ERROR\"",
            "refId": "A"
          }
        ],
        "options": {
          "showTime": true,
          "showLabels": true,
          "sortOrder": "Descending",
          "wrapLogMessage": true,
          "dedupStrategy": "none"
        }
      }
    ],
    "time": {
      "from": "now-15m",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
    }
  }
}
